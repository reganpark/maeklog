{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "objective_evidence",
    "discussion",
    "decisions",
    "progress",
    "blockers",
    "next_actions",
    "notes",
    "record_updates",
    "state_updates"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "maxLength": 600
    },
    "objective_evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "discussion": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "supersedes",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{3,}$"
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "proposed",
              "superseded",
              "reversed"
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^D-[0-9]{3,}$"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "progress": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "status",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "reported",
              "in_progress",
              "blocked",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "priority",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "priority": {
            "type": "string",
            "enum": [
              "user_decision",
              "current",
              "later",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "text",
          "evidence",
          "step",
          "when"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "enum": [
              "user",
              "sol",
              "luna",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "step": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "when": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "record_updates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "operation",
          "key",
          "target",
          "text",
          "condition",
          "stage",
          "outcome",
          "evidence",
          "decision_basis"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "completion"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "add",
              "restate",
              "replace",
              "withdraw",
              "follow_up"
            ]
          },
          "key": {
            "type": "string",
            "maxLength": 120
          },
          "target": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 120
              }
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1200
          },
          "condition": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 400
              }
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "decision",
              "implementation",
              "verification",
              "merge",
              "deployment",
              "other"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "confirmed",
              "reported",
              "failed",
              "rework",
              "passed"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "quote"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "maxLength": 120
                },
                "quote": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            }
          },
          "decision_basis": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "intent",
                  "reference",
                  "quote"
                ],
                "properties": {
                  "intent": {
                    "type": "string",
                    "enum": [
                      "explicit_choice",
                      "explicit_approval",
                      "conditional_approval",
                      "request",
                      "question",
                      "proposal",
                      "uncertain"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  }
                }
              }
            ]
          }
        }
      }
    },
    "state_updates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "text",
          "owner",
          "condition",
          "status",
          "change",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "progress",
              "blocker",
              "action"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1200
          },
          "owner": {
            "type": "string",
            "maxLength": 80
          },
          "condition": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 400
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "resolved",
              "unconfirmed"
            ]
          },
          "change": {
            "type": "string",
            "enum": [
              "same",
              "changed"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "quote"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "maxLength": 120
                },
                "quote": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            }
          }
        }
      }
    }
  }
}
