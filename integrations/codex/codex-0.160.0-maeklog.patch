@@ -0,0 +1,293 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn notification(method: &str, params: Value) -> ServerNotification {
+    serde_json::from_value(json!({"method": method, "params": params})).unwrap()
+}
+
+fn lifecycle(method: &str, thread: &str, turn: &str) -> ServerNotification {
+    notification(
+        method,
+        json!({"threadId": thread, "turn": {
+            "id": turn, "status": if method == "turn/started" { "inProgress" } else { "completed" },
+            "items": [{"type": "reasoning", "id": "private", "summary": ["SECRET"], "content": []}]
+        }}),
+    )
+}
+
+fn report(thread: &str, turn: &str, text: &str) -> ServerNotification {
+    notification(
+        "item/completed",
+        json!({"threadId": thread, "turnId": turn,
+            "completedAtMs": 0,
+            "item": {"id": "report", "type": "agentMessage", "phase": "commentary", "text": text}
+        }),
+    )
+}
+
+fn queued(progress: &LiveProgress) -> Vec<Value> {
+    progress
+        .pending
+        .lock()
+        .unwrap()
+        .0
+        .iter()
+        .map(|event| serde_json::from_slice(&event.bytes).unwrap())
+        .collect()
+}
+
+#[test]
+fn projects_only_public_item_metadata_and_completed_reports() {
+    let inputs = [
+        json!({"id": "command", "type": "commandExecution", "command": "cargo check", "cwd": "/repo",
+            "status": "completed", "commandActions": [], "exitCode": 1, "aggregatedOutput": "SECRET"}),
+        json!({"id": "mcp", "type": "mcpToolCall", "server": "files", "tool": "read", "status": "completed",
+            "arguments": {"password": "SECRET"}, "result": {"content": [{"type": "text", "text": "SECRET"}]}}),
+        json!({"id": "dynamic", "type": "dynamicToolCall", "tool": "query", "status": "completed",
+            "arguments": {"secret": "SECRET"}, "contentItems": [{"type": "inputText", "text": "SECRET"}]}),
+        json!({"id": "file", "type": "fileChange", "status": "completed",
+            "changes": [{"path": "src/main.rs", "kind": {"type": "update", "move_path": null}, "diff": "SECRET"}]}),
+        json!({"id": "assistant", "type": "agentMessage", "phase": "commentary", "text": "Building checks."}),
+        json!({"id": "private", "type": "reasoning", "summary": ["SECRET"], "content": ["SECRET"]}),
+        json!({"id": "final", "type": "agentMessage", "phase": "final_answer", "text": "Final answer."}),
+    ];
+    let items: Vec<ThreadItem> = inputs
+        .into_iter()
+        .map(|value| serde_json::from_value(value).unwrap())
+        .collect();
+    assert_eq!(
+        items
+            .iter()
+            .filter_map(|item| public_item(item, "item/completed"))
+            .collect::<Vec<_>>(),
+        vec![
+            json!({"id": "command", "type": "commandExecution", "command": "cargo check", "status": "completed", "exitCode": 1}),
+            json!({"id": "mcp", "type": "mcpToolCall", "server": "files", "tool": "read", "status": "completed"}),
+            json!({"id": "dynamic", "type": "dynamicToolCall", "tool": "query", "status": "completed"}),
+            json!({"id": "file", "type": "fileChange", "status": "completed", "changes": [{"path": "src/main.rs", "kind": {"type": "update"}}]}),
+            json!({"id": "assistant", "type": "agentMessage", "phase": "commentary", "text": "Building checks."}),
+        ]
+    );
+    assert_eq!(public_item(&items[4], "item/started"), None);
+}
