@@ -0,0 +1,92 @@
+//! Reports the terminal client's thread, never the shared server's environment.
+//! Optional local Maeklog adapter; failures must not stop a Codex conversation.
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::Duration;
+
+#[path = "herdr_bridge_live.rs"]
+mod live;
+
+pub(crate) struct HerdrBridge {
+    executable: PathBuf,
+    thread: Option<String>,
+    progress: Option<live::LiveProgress>,
+}
+
+impl HerdrBridge {
+    pub(crate) fn from_env() -> Option<Self> {
+        if std::env::var("HERDR_ENV").as_deref() != Ok("1")
+            || std::env::var_os("HERDR_PANE_ID").is_none()
+            || std::env::var_os("HERDR_SOCKET_PATH").is_none()
+        {
+            return None;
+        }
+        let executable = std::env::var_os("MAEKLOG_CLIENT_BIN")
+            .map(PathBuf::from)
+            .or_else(|| {
+                let config = std::env::var_os("XDG_CONFIG_HOME")
+                    .map(PathBuf::from)
+                    .or_else(|| {
+                        std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".config"))
+                    })?;
+                Some(config.join("herdr/plugins/config/maeklog/bin/maeklog-hook"))
+            })?;
+        executable.is_file().then_some(Self {
+            executable,
+            thread: None,
+            progress: None,
+        })
+    }
+
+    pub(crate) async fn attach(&mut self, thread: String) {
+        if self.thread.as_ref() != Some(&thread)
+            && let Some(progress) = &mut self.progress
+        {
+            progress.clear_active_turn();
+        }
+        self.thread = Some(thread.clone());
+        self.report("attach", &thread).await;
+    }
+
+    pub(crate) async fn detach(&mut self) {
+        if let Some(progress) = &mut self.progress {
+            progress.clear_active_turn();
+        }
+        if let Some(thread) = self.thread.take() {
+            self.report("detach", &thread).await;
+        }
+    }
+
+    /// Copies only bounded public progress; command delivery runs off the TUI event path.
+    pub(crate) fn observe(
+        &mut self,
+        notification: &codex_app_server_protocol::ServerNotification,
+        cwd: &std::path::Path,
+    ) {
+        let Some(thread) = &self.thread else {
+            return;
+        };
+        let progress = self
+            .progress
+            .get_or_insert_with(|| live::LiveProgress::new(self.executable.clone()));
+        progress.observe(thread, notification, cwd);
+    }
+
+    async fn report(&self, action: &str, thread: &str) {
+        let mut command = tokio::process::Command::new(&self.executable);
+        command.args(["client", action, &std::process::id().to_string(), thread]);
+        command
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        match tokio::time::timeout(Duration::from_secs(2), command.status()).await {
+            Ok(Ok(status)) if status.success() => {}
+            result => tracing::warn!(?result, "Maeklog client connection update failed"),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "herdr_bridge_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/herdr_bridge_live.rs b/codex-rs/tui/src/herdr_bridge_live.rs
new file mode 100644
index 0000000..0f461c3
--- /dev/null
+++ b/codex-rs/tui/src/herdr_bridge_live.rs
@@ -0,0 +1,319 @@
+//! Bounded public notification projection and best-effort local background delivery.
+use codex_app_server_protocol::PatchChangeKind;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::ThreadItem;
+use codex_protocol::models::MessagePhase;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::VecDeque;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use tokio::io::AsyncWriteExt;
+use tokio::sync::Notify;
+use tokio::task::JoinHandle;
+
+const MAX_PENDING: usize = 64;
+const MAX_PAYLOAD: usize = 32 * 1024;
+const MAX_ENDED_TURNS: usize = 32;
+
+struct PendingEvent {
+    thread: String,
+    turn: String,
+    key: String,
+    method: &'static str,
+    bytes: Vec<u8>,
+}
+
+#[derive(Default)]
+struct Pending(VecDeque<PendingEvent>);
+
+impl Pending {
+    fn push(&mut self, event: PendingEvent) {
+        self.0.retain(|queued| {
+            queued.thread != event.thread || queued.turn != event.turn || queued.key != event.key
+        });
+        if self.0.len() == MAX_PENDING {
+            // Latest public state supersedes pending updates, while turn terminal events
+            // survive tool floods. Only obsolete lifecycle history can exhaust this reserve.
+            let expendable = self
+                .0
+                .iter()
+                .position(|queued| !matches!(queued.method, "turn/started" | "turn/completed"));
+            if let Some(index) = expendable {
+                self.0.remove(index);
+            } else if event.method == "turn/completed" {
+                self.0.pop_front();
+            } else {
+                return;
+            }
+        }
+        self.0.push_back(event);
+    }
+}
+
+pub(super) struct LiveProgress {
+    active: Option<(String, String, PathBuf)>,
+    ended: VecDeque<(String, String)>,
+    sequence: u64,
+    pending: Arc<Mutex<Pending>>,
+    wake: Arc<Notify>,
+    worker: JoinHandle<()>,
+}
+
+impl LiveProgress {
+    pub(super) fn new(executable: PathBuf) -> Self {
+        let pending = Arc::new(Mutex::new(Pending::default()));
+        let wake = Arc::new(Notify::new());
+        let worker = tokio::spawn(deliver(executable, Arc::clone(&pending), Arc::clone(&wake)));
+        Self {
+            active: None,
+            ended: VecDeque::new(),
+            sequence: 0,
+            pending,
+            wake,
+            worker,
+        }
+    }
+
+    pub(super) fn clear_active_turn(&mut self) {
+        self.active = None;
+    }
+
+    pub(super) fn observe(
+        &mut self,
+        attached: &str,
+        notification: &ServerNotification,
+        cwd: &Path,
+    ) {
+        let (thread, turn, method, key, params) = match notification {
+            ServerNotification::TurnStarted(event) => (
+                &event.thread_id,
+                &event.turn.id,
+                "turn/started",
+                "started".to_string(),
+                json!({"threadId": event.thread_id, "turn": {"id": event.turn.id, "status": event.turn.status}}),
+            ),
+            ServerNotification::TurnCompleted(event) => (
+                &event.thread_id,
+                &event.turn.id,
+                "turn/completed",
+                "completed".to_string(),
+                json!({"threadId": event.thread_id, "turn": {"id": event.turn.id, "status": event.turn.status}}),
+            ),
+            ServerNotification::TurnPlanUpdated(event) => (
+                &event.thread_id,
+                &event.turn_id,
+                "turn/plan/updated",
+                "plan".to_string(),
+                json!({"threadId": event.thread_id, "turnId": event.turn_id,
+                    "explanation": event.explanation.as_deref().map(|text| bounded(text, /*limit*/ 400)),
+                    "plan": event.plan.iter().take(/*n*/ 16).map(|step| json!({"step": bounded(&step.step, /*limit*/ 400), "status": step.status})).collect::<Vec<_>>()}),
+            ),
+            ServerNotification::ItemStarted(event) => {
+                let Some(item) = public_item(&event.item, "item/started") else {
+                    return;
+                };
+                (
+                    &event.thread_id,
+                    &event.turn_id,
+                    "item/started",
+                    format!("item:{}", event.item.id()),
+                    json!({"threadId": event.thread_id, "turnId": event.turn_id, "item": item}),
+                )
+            }
+            ServerNotification::ItemCompleted(event) => {
+                let Some(item) = public_item(&event.item, "item/completed") else {
+                    return;
+                };
+                let key = if matches!(&event.item, ThreadItem::AgentMessage { .. }) {
+                    "report".to_string()
+                } else {
+                    format!("item:{}", event.item.id())
+                };
+                (
+                    &event.thread_id,
+                    &event.turn_id,
+                    "item/completed",
+                    key,
+                    json!({"threadId": event.thread_id, "turnId": event.turn_id, "item": item}),
+                )
+            }
+            _ => return,
+        };
+        if thread != attached
+            || thread.len() > 200
+            || turn.len() > 200
+            || self
+                .ended
+                .iter()
+                .any(|ended| ended.0 == *thread && ended.1 == *turn)
+        {
+            return;
+        }
+        if method == "turn/started" {
+            if self
+                .active
+                .as_ref()
+                .is_some_and(|active| active.0 == *thread && active.1 == *turn)
+            {
+                return;
+            }
+            self.active = Some((thread.clone(), turn.clone(), cwd.to_path_buf()));
+        }
+        let Some((active_thread, active_turn, turn_cwd)) = &self.active else {
+            return;
+        };
+        if active_thread != thread || active_turn != turn {
+            return;
+        }
+        self.sequence = self.sequence.saturating_add(1);
+        let envelope = json!({"sequence": self.sequence, "cwd": turn_cwd.to_string_lossy(),
+            "notification": {"method": method, "params": params}});
+        if let Ok(bytes) = serde_json::to_vec(&envelope)
+            && bytes.len() < MAX_PAYLOAD
+        {
+            self.pending
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .push(PendingEvent {
+                    thread: thread.clone(),
+                    turn: turn.clone(),
+                    key,
+                    method,
+                    bytes,
+                });
+            self.wake.notify_one();
+        }
+        if method == "turn/completed" {
+            if self.ended.len() == MAX_ENDED_TURNS {
+                self.ended.pop_front();
+            }
+            self.ended.push_back((thread.clone(), turn.clone()));
+            self.active = None;
+        }
+    }
+}
+
+impl Drop for LiveProgress {
+    fn drop(&mut self) {
+        self.worker.abort();
+    }
+}
+
+fn bounded(text: &str, limit: usize) -> String {
+    text.chars().take(limit).collect()
+}
+
+fn public_item(item: &ThreadItem, method: &str) -> Option<Value> {
+    if item.id().len() > 200 {
+        return None;
+    }
+    let mut fields = match item {
+        ThreadItem::AgentMessage { text, phase, .. }
+            if method == "item/completed" && phase.as_ref() != Some(&MessagePhase::FinalAnswer) =>
+        {
+            json!({"type": "agentMessage", "text": bounded(text, /*limit*/ 4000), "phase": phase})
+        }
+        ThreadItem::CommandExecution {
+            command,
+            status,
+            exit_code,
+            ..
+        } => {
+            json!({"type": "commandExecution", "command": bounded(command, /*limit*/ 300), "status": status, "exitCode": exit_code})
+        }
+        ThreadItem::McpToolCall {
+            server,
+            tool,
+            status,
+            ..
+        } => {
+            json!({"type": "mcpToolCall", "server": bounded(server, /*limit*/ 160), "tool": bounded(tool, /*limit*/ 160), "status": status})
+        }
+        ThreadItem::DynamicToolCall { tool, status, .. } => {
+            json!({"type": "dynamicToolCall", "tool": bounded(tool, /*limit*/ 160), "status": status})
+        }
+        ThreadItem::CollabAgentToolCall { tool, status, .. } => {
+            json!({"type": "collabAgentToolCall", "tool": tool, "status": status})
+        }
+        ThreadItem::FileChange {
+            changes, status, ..
+        } => {
+            let changes: Vec<_> = changes
+                .iter()
+                .take(/*n*/ 16)
+                .map(|change| {
+                    let kind = match &change.kind {
+                        PatchChangeKind::Add => json!({"type": "add"}),
+                        PatchChangeKind::Delete => json!({"type": "delete"}),
+                        PatchChangeKind::Update { .. } => json!({"type": "update"}),
+                    };
+                    json!({"path": bounded(&change.path, /*limit*/ 400), "kind": kind})
+                })
+                .collect();
+            json!({"type": "fileChange", "changes": changes, "status": status})
+        }
+        ThreadItem::ImageView { path, .. } => {
+            json!({"type": "imageView", "path": bounded(path.as_str(), /*limit*/ 400)})
+        }
+        ThreadItem::WebSearch(search) => {
+            json!({"type": "webSearch", "query": bounded(&search.query, /*limit*/ 300)})
+        }
+        ThreadItem::AgentMessage { .. }
+        | ThreadItem::UserMessage { .. }
+        | ThreadItem::HookPrompt { .. }
+        | ThreadItem::FunctionCallOutput { .. }
+        | ThreadItem::Plan { .. }
+        | ThreadItem::Reasoning { .. }
+        | ThreadItem::SubAgentActivity { .. }
+        | ThreadItem::Sleep(_)
+        | ThreadItem::ImageGeneration(_)
+        | ThreadItem::EnteredReviewMode { .. }
+        | ThreadItem::ExitedReviewMode { .. }
+        | ThreadItem::ContextCompaction { .. } => return None,
+    };
+    fields["id"] = json!(item.id());
+    Some(fields)
+}
+
+async fn deliver(executable: PathBuf, pending: Arc<Mutex<Pending>>, wake: Arc<Notify>) {
+    let pid = std::process::id().to_string();
+    loop {
+        let notified = wake.notified();
+        let next = pending
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .0
+            .pop_front();
+        let Some(event) = next else {
+            notified.await;
+            continue;
+        };
+        let mut command = tokio::process::Command::new(&executable);
+        command.args(["live", "event", &pid, &event.thread]);
+        command
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        let result = tokio::time::timeout(Duration::from_secs(/*secs*/ 2), async {
+            let mut child = command.spawn()?;
+            if let Some(mut stdin) = child.stdin.take() {
+                stdin.write_all(&event.bytes).await?;
+            }
+            child.wait().await
+        })
+        .await;
+        if !matches!(&result, Ok(Ok(status)) if status.success()) {
+            tracing::warn!(?result, "Maeklog live progress delivery failed");
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "herdr_bridge_live_tests.rs"]
+mod tests;
