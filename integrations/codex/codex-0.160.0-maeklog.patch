+#[cfg(unix)]
+#[tokio::test]
+async fn sends_ordered_attach_switch_and_detach_from_the_client() {
+    use super::HerdrBridge;
+    use pretty_assertions::assert_eq;
+    use std::os::unix::fs::PermissionsExt;
+    let root = tempfile::tempdir().unwrap();
+    let script = root.path().join("bridge");
+    // A fixed sibling output path avoids interpolating paths into shell source.
+    std::fs::write(
+        &script,
+        "#!/bin/sh\nprintf '%s %s %s %s\\n' \"$1\" \"$2\" \"$3\" \"$4\" >> \"$0.calls\"\n",
+    )
+    .unwrap();
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let mut bridge = HerdrBridge {
+        executable: script.clone(),
+        thread: None,
+        progress: None,
+    };
+    bridge.attach("thread-a".into()).await;
+    bridge.attach("thread-b".into()).await;
+    bridge.detach().await;
+    bridge.detach().await;
+    let actual = std::fs::read_to_string(script.with_extension("calls")).unwrap();
+    let pid = std::process::id();
+    assert_eq!(
+        actual,
+        format!(
+            "client attach {pid} thread-a\nclient attach {pid} thread-b\nclient detach {pid} thread-b\n"
+        )
+    );
+}
