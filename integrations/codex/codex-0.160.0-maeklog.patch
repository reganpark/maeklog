+#[tokio::test]
+async fn bounds_text_plans_and_payloads_without_splitting_unicode() {
+    let mut progress = LiveProgress::new(PathBuf::from("unused-test-hook"));
+    progress.observe(
+        "main",
+        &lifecycle("turn/started", "main", "turn"),
+        Path::new("/repo"),
+    );
+    progress.observe(
+        "main",
+        &report("main", "turn", &"가".repeat(/*n*/ 5000)),
+        Path::new("/repo"),
+    );
+    let plan = notification(
+        "turn/plan/updated",
+        json!({"threadId": "main", "turnId": "turn",
+        "explanation": "Explanation.", "plan": (0..30).map(|_| json!({"step": "가".repeat(/*n*/ 500), "status": "inProgress"})).collect::<Vec<_>>() }),
+    );
+    progress.observe("main", &plan, Path::new("/repo"));
+    let events = queued(&progress);
+    assert_eq!(
+        events[1]["notification"]["params"]["item"]["text"],
