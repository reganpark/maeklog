+#[cfg(unix)]
+#[tokio::test]
+async fn slow_failing_hook_runs_in_background_and_delivers_coalesced_native_envelopes() {
+    use std::os::unix::fs::PermissionsExt;
+    let root = tempfile::tempdir().unwrap();
+    let script = root.path().join("bridge");
+    std::fs::write(&script, "#!/bin/sh\nprintf '%s %s %s %s\\n' \"$1\" \"$2\" \"$3\" \"$4\" >> \"$0.calls\"\ncat >> \"$0.events\"\nprintf '\\n' >> \"$0.events\"\nwhile ! test -f \"$0.release\"; do sleep 0.01; done\nexit 1\n").unwrap();
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(/*mode*/ 0o700)).unwrap();
+    let mut progress = LiveProgress::new(script.clone());
+    progress.observe(
+        "main",
+        &lifecycle("turn/started", "main", "turn"),
+        Path::new("/repo"),
+    );
+    tokio::time::timeout(Duration::from_secs(/*secs*/ 2), async {
+        while !script.with_extension("events").exists() {
+            tokio::time::sleep(Duration::from_millis(/*millis*/ 10)).await;
+        }
+    })
+    .await
+    .unwrap();
+    for index in 0..100 {
+        progress.observe(
+            "main",
+            &report("main", "turn", &format!("Working {index}")),
+            Path::new("/repo"),
+        );
+        progress.observe("main", &notification("turn/plan/updated", json!({"threadId": "main", "turnId": "turn",
+            "explanation": null, "plan": [{"step": format!("Step {index}"), "status": "inProgress"}]})), Path::new("/repo"));
+    }
+    progress.observe(
+        "main",
+        &lifecycle("turn/completed", "main", "turn"),
+        Path::new("/repo"),
+    );
+    assert_eq!(queued(&progress).len(), 3);
+    std::fs::write(script.with_extension("release"), "").unwrap();
+    let events = tokio::time::timeout(Duration::from_secs(/*secs*/ 3), async {
+        loop {
+            let contents = std::fs::read_to_string(script.with_extension("events")).unwrap();
+            let events: Vec<Value> = contents
+                .lines()
+                .filter_map(|line| serde_json::from_str(line).ok())
+                .collect();
+            if events.len() == 4 {
+                break events;
+            }
+            tokio::time::sleep(Duration::from_millis(/*millis*/ 10)).await;
+        }
+    })
+    .await
+    .unwrap();
+    assert_eq!(
+        events
+            .iter()
+            .map(|event| event["sequence"].clone())
+            .collect::<Vec<_>>(),
+        vec![json!(1), json!(200), json!(201), json!(202)]
+    );
+    assert_eq!(
+        events[1]["notification"]["params"]["item"]["text"],
+        json!("Working 99")
+    );
+    assert_eq!(events[3]["notification"]["method"], json!("turn/completed"));
+    let pid = std::process::id();
+    assert_eq!(
+        std::fs::read_to_string(script.with_extension("calls")).unwrap(),
+        format!("live event {pid} main\n").repeat(/*n*/ 4)
+    );
+}
