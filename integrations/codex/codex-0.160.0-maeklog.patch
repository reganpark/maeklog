+#[test]
+fn tool_flood_coalesces_item_lifecycle_without_evicting_turn_completion() {
+    let mut pending = Pending::default();
+    for (method, key) in [("turn/started", "started"), ("turn/completed", "completed")] {
+        pending.push(PendingEvent {
+            thread: "main".into(),
+            turn: "turn".into(),
+            key: key.into(),
+            method,
+            bytes: vec![],
+        });
+    }
+    for index in 0..200 {
+        let key = format!("item:{index}");
+        pending.push(PendingEvent {
+            thread: "main".into(),
+            turn: "turn".into(),
+            key: key.clone(),
+            method: "item/started",
+            bytes: vec![],
+        });
+        pending.push(PendingEvent {
+            thread: "main".into(),
+            turn: "turn".into(),
+            key,
+            method: "item/completed",
+            bytes: vec![],
+        });
+    }
+    assert_eq!(pending.0.len(), MAX_PENDING);
+    assert_eq!(
+        pending
+            .0
+            .iter()
+            .take(/*n*/ 2)
+            .map(|event| event.method)
+            .collect::<Vec<_>>(),
+        vec!["turn/started", "turn/completed"]
+    );
+    assert!(
+        pending
+            .0
+            .iter()
+            .skip(/*n*/ 2)
+            .all(|event| event.method == "item/completed")
+    );
+}
