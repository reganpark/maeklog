+    assert_eq!(
+        events[2]["notification"]["params"]["plan"],
+        json!(
+            (0..16)
+                .map(|_| json!({"step": "가".repeat(/*n*/ 400), "status": "inProgress"}))
+                .collect::<Vec<_>>()
+        )
+    );
+    assert!(
+        progress
+            .pending
+            .lock()
+            .unwrap()
+            .0
+            .iter()
+            .all(|event| event.bytes.len() < MAX_PAYLOAD)
