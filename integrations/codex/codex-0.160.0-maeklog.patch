+            json!({"sequence": 3, "cwd": "/actual", "notification": {"method": "turn/completed", "params": {"threadId": "main", "turn": {"id": "turn-a", "status": "completed"}}}}),
+            json!({"sequence": 4, "cwd": "/new", "notification": {"method": "turn/started", "params": {"threadId": "main", "turn": {"id": "turn-b", "status": "inProgress"}}}}),
