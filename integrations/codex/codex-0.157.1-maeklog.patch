diff --git a/codex-rs/tui/src/herdr_bridge.rs b/codex-rs/tui/src/herdr_bridge.rs
new file mode 100644
index 0000000..1f96eac
--- /dev/null
+++ b/codex-rs/tui/src/herdr_bridge.rs
@@ -0,0 +1,64 @@
+//! Reports the terminal client's thread, never the shared server's environment.
+//! Optional local Maeklog adapter; failures must not stop a Codex conversation.
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::Duration;
+
+pub(crate) struct HerdrBridge {
+    executable: PathBuf,
+    thread: Option<String>,
+}
+
+impl HerdrBridge {
+    pub(crate) fn from_env() -> Option<Self> {
+        if std::env::var("HERDR_ENV").as_deref() != Ok("1")
+            || std::env::var_os("HERDR_PANE_ID").is_none()
+            || std::env::var_os("HERDR_SOCKET_PATH").is_none()
+        {
+            return None;
+        }
+        let executable = std::env::var_os("MAEKLOG_CLIENT_BIN")
+            .map(PathBuf::from)
+            .or_else(|| {
+                let config = std::env::var_os("XDG_CONFIG_HOME")
+                    .map(PathBuf::from)
+                    .or_else(|| {
+                        std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".config"))
+                    })?;
+                Some(config.join("herdr/plugins/config/maeklog/bin/maeklog-hook"))
+            })?;
+        executable.is_file().then_some(Self {
+            executable,
+            thread: None,
+        })
+    }
+
+    pub(crate) async fn attach(&mut self, thread: String) {
+        self.thread = Some(thread.clone());
+        self.report("attach", &thread).await;
+    }
+
+    pub(crate) async fn detach(&mut self) {
+        if let Some(thread) = self.thread.take() {
+            self.report("detach", &thread).await;
+        }
+    }
+
+    async fn report(&self, action: &str, thread: &str) {
+        let mut command = tokio::process::Command::new(&self.executable);
+        command.args(["client", action, &std::process::id().to_string(), thread]);
+        command
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        match tokio::time::timeout(Duration::from_secs(2), command.status()).await {
+            Ok(Ok(status)) if status.success() => {}
+            result => tracing::warn!(?result, "Maeklog client connection update failed"),
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "herdr_bridge_tests.rs"]
+mod tests;
